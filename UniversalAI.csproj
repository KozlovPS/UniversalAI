<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs;tests\**\*.cs" />
    <ProjectReference Include="src\UniversalAI.Engine\UniversalAI.Engine.csproj" />
    <ProjectReference Include="src\UniversalAI.Benchmarks\UniversalAI.Benchmarks.csproj" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.local.json" Condition="Exists('appsettings.local.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
