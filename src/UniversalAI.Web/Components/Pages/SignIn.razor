@page "/signin"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Вход — UniversalAI</PageTitle>
<div class="narrow"><div class="eyebrow">РАБОЧЕЕ ПРОСТРАНСТВО</div><h1>Войти в лабораторию</h1>
<p class="muted">Введите токен доступа, заданный на сервере.</p>
@if (Error == "1") { <p class="alert" role="alert">Токен не подошёл.</p> }
<form action="/auth/login" method="post" class="panel stack">
    <AntiforgeryToken />
    <label>Токен доступа<input name="token" type="password" required autocomplete="current-password" /></label>
    <button type="submit">Войти</button>
</form></div>
@code { [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; } }
