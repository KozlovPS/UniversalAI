@page "/runs/{Id}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject FileRunStore Store
@inject BenchmarkQueue Queue

<PageTitle>Прогон — UniversalAI</PageTitle>
<a class="back-link" href="/experiments">← Эксперименты</a>
@if (_error != null) { <p class="alert" role="alert">@_error</p> }
@if (_run != null)
{
    <div class="page-heading"><div><div class="eyebrow">@_run.BenchmarkId.ToUpperInvariant() / @_run.Id[..8]</div><h1>@_run.Model</h1><p class="muted">@_run.Provider.Name · @_run.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</p></div>
    <div class="actions"><span class="badge @_run.Status.ToString().ToLowerInvariant()">@RunLabels.Status(_run.Status)</span>@if (_run.Status is RunStatus.Running or RunStatus.Queued) { <button class="secondary" @onclick="Cancel">Отменить</button> }<button class="secondary" @onclick="Refresh">Обновить</button></div></div>
    @if (_run.Error != null) { <p class="alert" role="status">@_run.Error</p> }
    <div class="stats"><div class="stat"><span>ВЫЗОВЫ API</span><strong>@_run.CompletedCalls</strong><small>С учётом ответов и памяти</small></div><div class="stat"><span>ДЛИТЕЛЬНОСТЬ</span><strong>@Duration</strong><small>От начала выполнения</small></div><div class="stat"><span>АРТЕФАКТЫ</span><strong>@_artifacts.Count</strong><small>Включая частичные результаты</small></div></div>
    <div class="two-columns"><section class="panel"><h2>Результаты</h2><div class="artifact-list">@foreach (var name in _artifacts) { <div><button class="text-button" @onclick="() => Preview(name)">@name</button><a href="@($"/downloads/{Id}/{Uri.EscapeDataString(name)}")" target="_blank">Скачать ↗</a></div> }</div>@if (_artifacts.Count == 0) { <p class="muted">Артефакты появятся по мере выполнения.</p> }</section>
    <section class="panel"><h2>Условия эксперимента</h2><dl><dt>Подключение</dt><dd>@_run.Provider.BaseUrl</dd><dt>Стратегии и параметры</dt><dd>keep=@_run.Settings.Keep, batch=@_run.Settings.Batch, ветки=@_run.Settings.Branches</dd><dt>Снимок тарифов</dt><dd>@_run.PricingSnapshot</dd><dt>Версии</dt><dd>Сценарий @_run.ScenarioVersion / оценивание @_run.ScorerVersion</dd></dl></section></div>
    @if (_preview != null) { <section class="panel"><h2>@_previewName</h2><pre class="report-preview">@_preview</pre></section> }
    <section class="panel"><div class="section-heading"><h2>Журнал выполнения</h2><span class="muted">Обновляется каждые 2 секунды · последние 64 КБ</span></div><pre class="log">@(_log.Length == 0 ? "Ожидание выполнения…" : _log)</pre></section>
}
@code {
    [Parameter] public string Id { get; set; } = "";
    private BenchmarkRun? _run;
    private IReadOnlyList<string> _artifacts = [];
    private string _log = "", _previewName = "";
    private string? _preview, _error;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _polling;
    private string Duration => _run?.StartedAt is { } start ? ((_run.FinishedAt ?? DateTimeOffset.UtcNow) - start).ToString(@"hh\:mm\:ss") : "—";
    protected override async Task OnParametersSetAsync() { await Refresh(); if (_polling == null || _polling.IsCompleted) _polling = Poll(); }
    private async Task Poll()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) { await InvokeAsync(Refresh); if (_run?.Status is not (RunStatus.Running or RunStatus.Queued)) break; } }
        catch (OperationCanceledException) { }
    }
    private async Task Refresh()
    {
        try { _run = await Store.GetAsync(Id, _lifetime.Token); _artifacts = await Store.ArtifactsAsync(Id, _lifetime.Token); _log = await UniversalAI.Web.WorkspaceApi.ReadLogTailAsync(Path.Combine(Store.GetDirectory(Id), "output.log"), _lifetime.Token); StateHasChanged(); }
        catch (OperationCanceledException) { }
        catch (Exception e) { _error = e.Message; }
    }
    private async Task Cancel() { try { await Queue.CancelAsync(Id); await Refresh(); } catch (Exception e) { _error = e.Message; } }
    private async Task Preview(string name)
    {
        try
        {
            string path = await Store.ArtifactPathAsync(Id, name);
            _previewName = name;
            _preview = new FileInfo(path).Length > 1_048_576 ? "Файл больше 1 МБ. Скачайте его для просмотра." : await File.ReadAllTextAsync(path);
        }
        catch (Exception e) { _error = e.Message; }
    }
    public async ValueTask DisposeAsync() { await _lifetime.CancelAsync(); if (_polling != null) await _polling; _lifetime.Dispose(); }
}
